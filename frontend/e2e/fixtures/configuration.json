  "schema": {
    "group_descriptions": {
      "research": {
        "en": "Applies to newly created research. A Run's explicit selection takes precedence.",
        "zh-CN": "对新建研究生效；本次研究的显式选择优先。",
        "ja": "新規リサーチに適用。各リサーチの明示的な指定が優先されます。"
      },
      "news": {
        "en": "Controls requested coverage or output, not historical completeness. Source limits still apply.",
        "zh-CN": "控制请求范围或输出量，不代表历史覆盖完整；仍受数据源限制。",
        "ja": "要求範囲・出力を制御します。過去データの網羅性は保証せず、取得元の制限が適用されます。"
      },
      "cache": {
        "en": "Changes apply to new research; the cache retains only previously observed material.",
        "zh-CN": "对新建研究生效；缓存只保留曾经观察到的资料。",
        "ja": "新規リサーチに適用。キャッシュは取得済み資料のみを保持します。"
      },
      "sources": {
        "en": "Ordered fallback: tool override, then market override, then default category. Only selected sources are used.",
        "zh-CN": "按工具覆盖、市场覆盖、默认类别解析；仅使用选中的来源，按顺序回退。",
        "ja": "ツール、市場、既定カテゴリの優先順で解決し、選択したソースのみを順に使用します。"
      }
    },
