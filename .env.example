# Optional startup and deployment configuration.
# Start the application, open Settings, and configure daily research settings
# and provider/data credentials there. No .env file is needed for local defaults.
# Existing .env / .env.enterprise files can be previewed and imported in Settings.
# Daily environment values stop participating after DB initialization.

# Local state; Compose uses /data paths.
#TRADINGAGENTS_HOME=~/.tradingagents
#TRADINGAGENTS_DATABASE_PATH=~/.tradingagents/tradingagents.db
#TRADINGAGENTS_CACHE_DIR=~/.tradingagents/cache

# Web and worker startup policy (restart after changes).
#TRADINGAGENTS_HOST=127.0.0.1
#TRADINGAGENTS_PORT=8000
#TRADINGAGENTS_WORKER_POLL_SECONDS=1.0
#TRADINGAGENTS_LEASE_SECONDS=300
#TRADINGAGENTS_SQLITE_BUSY_TIMEOUT_MS=5000

# Docker host publication.
#TRADINGAGENTS_PUBLISH_HOST=127.0.0.1
#TRADINGAGENTS_WEB_PORT=8000

# Optional LAN access, independent of model/data credentials.
#TRADINGAGENTS_LAN_ENABLED=false
#TRADINGAGENTS_LAN_TOKEN=
#TRADINGAGENTS_SESSION_SECRET=
